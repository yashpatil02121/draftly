# Copy to server/.env and adjust. Never commit real secrets.
# Matches docker-compose.yml (docker compose up -d db)
DATABASE_URL=postgres://draftly:draftly@localhost:5433/draftly
TEST_DATABASE_URL=postgres://draftly:draftly@localhost:5433/draftly_test
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Password given to seeded demo accounts (alice/bob/carol@example.com)
DEMO_PASSWORD=demo-pass-123
